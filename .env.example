# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_MODEL="gemini-3.8-flash"
AI_RATE_LIMIT_PER_HOUR="30"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
PORT="3000"
NODE_ENV="development"

# Frontend API Base URL (defaults to /api/v1 on same origin)
VITE_API_BASE_URL="/api/v1"

# Neon PostgreSQL Connection String (configured via Google AI Studio Secrets as DATABASE_URL)
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Authentication & Session Configuration (replace placeholders in production)
JWT_ACCESS_SECRET="change_me_to_at_least_32_random_characters_access"
JWT_REFRESH_SECRET="change_me_to_at_least_32_random_characters_refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
CORS_ORIGINS=""
COOKIE_DOMAIN=""

# Seed & Custodian Bootstrap Configuration (local demonstration defaults)
SEED_ADMIN_EMAIL="admin.tpo@nie-placement.edu"
SEED_ADMIN_PASSWORD="change_me_admin_password"
SEED_STUDENT_PASSWORD="change_me_student_password"

# File Storage Adapter Configuration (local | s3 | firebase | supabase)
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Optional Email Delivery Adapter (disabled unless configured)
EMAIL_PROVIDER=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Optional Trusted External Code Execution Sandbox (disabled -> PRACTICE mode by default)
CODE_EXEC_PROVIDER=""
CODE_EXEC_URL=""
CODE_EXEC_API_KEY=""
